     <property name="styleSheet">
      <string notr="true">QComboBox {
    background-color: #f3f4f6;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 6px 10px;
}

QComboBox::drop-down {
    width: 24px;
}

QComboBox:hover {
    border: 1px solid #a78bfa;
}

QComboBox:focus {
    border: 1px solid #7c3aed;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #111827;
