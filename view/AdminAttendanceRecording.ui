    background-color: #1e293b;
    color: white;
	font-family: &quot;Segoe UI&quot;;
}

QCalendarWidget QWidget {
    alternate-background-color: #402E65;
}

QCalendarWidget QToolButton {
    color: white;
	font-family: &quot;Segoe UI&quot;;
    background: #00000;
}

QCalendarWidget QAbstractItemView {
